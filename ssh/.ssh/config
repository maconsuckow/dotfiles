# --- Global Settings ---
Host *
    # Keeps the connection alive during network blips
    ServerAliveInterval 60
    ServerAliveCountMax 5
    # Automatically try your SSH keys before asking for a password
    PreferredAuthentications publickey,password
    # This prevents "Host identification changed" errors on your local network
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

# --- Individual Device Entries ---

Host networkwall
    HostName 192.168.86.53
    User pi

Host macon-desktop
    HostName 192.168.86.59
    User macon

Host kiosk
    HostName 192.168.86.70
    User pi

Host pihole
    HostName 192.168.86.64
    User admin

Host github.com
    HostName github.com
    IdentityFile ~/.ssh/maconsuckow_github

Host gitlab.com
    HostName gitlab.com
    IdentityFile ~/.ssh/id_ed25519
